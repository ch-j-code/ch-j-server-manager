{
  "name": "ch-j-server-manager",
  "version": "0.0.1",
  "description": "Desktop SSH and SFTP client, Linux server manager, and local hash calculator with 49 checksum algorithms.",
  "homepage": "https://www.sm.ch-j.de",
  "license": "Apache-2.0",
  "author": "Josef Chudy <josef@ch-j.de>",
  "desktopName": "ch-j-server-manager",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node --test",
    "test:diagnostics:ui": "electron scripts/smokeDiagnostics.js",
    "licenses:generate": "node scripts/generateThirdPartyNotices.js",
    "prepare:release": "npm run licenses:generate && npm run biometrics:build && npm run stamp:build",
    "stamp:build": "node scripts/stampBuild.js",
    "prebuild": "npm run prepare:release",
    "build": "electron-builder",
    "prebuild:mac": "npm run prepare:release",
    "build:mac": "electron-builder --mac && npm run package:mac:installer",
    "prebuild:win": "npm run prepare:release",
    "build:win": "electron-builder --win",
    "prebuild:linux": "npm run prepare:release",
    "build:linux": "electron-builder --linux",
    "dist:mac": "npm run build:mac",
    "dist:win": "npm run build:win",
    "dist:linux": "npm run build:linux",
    "package:mac:installer": "node scripts/packageMacInstaller.js",
    "biometrics:build": "node scripts/buildBiometricHelpers.js",
    "prestart": "npm run biometrics:build",
    "predev": "npm run biometrics:build",
    "test:biometrics:ui": "electron scripts/smokeBiometrics.js"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "archiver": "^5.3.2",
    "builder": "^5.0.0",
    "farmhashjs": "1.0.1",
    "hash-wasm": "4.12.0",
    "highwayhasher": "0.4.4",
    "openpgp": "^6.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "monaco-editor": "^0.47.0",
    "ttf2woff": "^3.0.0"
  },
  "build": {
    "appId": "de.ch-j.servermanager",
    "productName": "CH-J Server Manager",
    "asar": true,
    "files": [
      "src/**",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.txt",
      "!node_modules/cpu-features/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/APPLICATION_LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "licenses/NOTICE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "licenses/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "THIRD_PARTY_LICENSES.zip",
        "to": "licenses/THIRD_PARTY_LICENSES.zip"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/ELECTRON_LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/CHROMIUM_LICENSES.html"
      },
      {
        "from": "ch-j-signing-public.asc",
        "to": "signing/ch-j-signing-public.asc"
      },
      {
        "from": "build/biometrics",
        "to": "biometrics",
        "filter": [
          "chj-biometric",
          "chj-biometric.exe",
          "linux.py"
        ]
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "CH-J Server Manager connects to your servers over SSH/SFTP and runs network diagnostics on the local network."
      }
    },
    "linux": {
      "icon": "build/linux-icons",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "synopsis": "SSH and server management application",
      "maintainer": "Josef Chudy <josef@ch-j.de>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "ch-j-server-manager"
        }
      }
    },
    "deb": {
      "recommends": [
        "python3-gi",
        "gir1.2-secret-1",
        "gnome-keyring",
        "fprintd"
      ]
    }
  },
  "keywords": [
    "ssh",
    "sftp",
    "server-management",
    "hash-calculator",
    "checksum",
    "file-integrity",
    "sha256",
    "sha512",
    "sha3",
    "blake3",
    "xxhash",
    "electron",
    "linux",
    "macos",
    "windows"
  ]
}
