# This repository tracks only the active application and repository metadata.
/*
!/.github/
!/.gitignore
!/.gitleaks.toml
!/LICENSE
!/README.md
!/app/

# macOS and editor metadata
.DS_Store
._*
*.swp
*.swo

# Dependencies and generated build output
**/node_modules/
app/dist/
plugin-dist/
**/tmp/

# Published installers and update packages are stored outside Git
web/sm-ch-j.de.cz.eu/files/**
!web/sm-ch-j.de.cz.eu/files/.htaccess

# Production configuration and runtime data
**/config.local.php
web/sm-ch-j.de.cz.eu/data/*.json
web/sm-ch-j.de.cz.eu/data/*.lock
/distrovm.txt

# Local secrets, keys, certificates, databases, and logs
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log

# Workspace-only integration tests belong to the separate web/plugin projects.
app/test/faqPortal.test.js
app/test/fileManagerPlugin.test.js
app/test/nginxManagerPlugin.test.js
app/test/systemMonitorPlugin.test.js
app/test/updatePortal.test.js
app/test/visitorCounter.test.js
app/test/webI18n.test.js
app/test/webSeo.test.js
app/test/wikiPortal.test.js

# Deliberately public local diagnostics TLS fixtures (never deployment credentials).
!/app/test/fixtures/diagnostics/ca.pem
!/app/test/fixtures/diagnostics/server.pem
!/app/test/fixtures/diagnostics/expired.pem
!/app/test/fixtures/diagnostics/server-key.pem

# Native biometric helpers are compiled per platform.
app/build/biometrics/
